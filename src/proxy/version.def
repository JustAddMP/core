    GetFileVersionInfoSizeExW = mc_GetFileVersionInfoSizeExW @7
    GetFileVersionInfoSizeW = mc_GetFileVersionInfoSizeW @8
    GetFileVersionInfoW = mc_GetFileVersionInfoW @9
    VerFindFileA = mc_VerFindFileA @10
    VerFindFileW = mc_VerFindFileW @11
    VerInstallFileA = mc_VerInstallFileA @12
    VerInstallFileW = mc_VerInstallFileW @13
    VerLanguageNameA = mc_VerLanguageNameA @14
